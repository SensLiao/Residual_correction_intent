# Kept out of git: model weights, data, results, caches, and the tests (they are local checks only).
*.pt
*.pth
/tests/
/pytest.ini
/sirb_results/
*.nii.gz
*.npy
*.npz
# datasets/ holds the downloaded data; only its README files are tracked.
/datasets/**
!/datasets/**/
!/datasets/**/README.md
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
