    family-names: Liao
    affiliation: "University of Sydney"
    orcid: "https://orcid.org/0009-0001-1761-7942"
keywords:
  - medical image segmentation
  - PET/CT
  - interactive segmentation
  - human-in-the-loop
  - reproducibility
